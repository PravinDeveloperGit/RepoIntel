# =============================================================
# Repository Intelligence — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.
# =============================================================

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/repointel
MONGODB_DB_NAME=repointel

# --- Backend ---
BACKEND_PORT=4000
NODE_ENV=development

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=7d

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000/api
VITE_AI_SERVICE_URL=http://localhost:8000

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# --- Embedding Model ---
# Options: all-MiniLM-L6-v2 (fast/free), all-mpnet-base-v2 (better quality)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- Reranker ---
# Options: lexical (no model needed), cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL=lexical
RERANKER_ENABLED=true

# --- LLM Provider ---
# Options: ollama, openai, groq, none (extractive fallback)
LLM_PROVIDER=none
LLM_MODEL=llama3.2

# --- Ollama (if LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (if LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Groq (if LLM_PROVIDER=groq) ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=200
MAX_FILE_COUNT=5000
MAX_SINGLE_FILE_SIZE_MB=2

# --- Index Storage ---
INDEX_STORAGE_PATH=./indexes
VECTOR_INDEX_NLIST=100

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Evaluation ---
EVAL_DATASET_PATH=./datasets
EVAL_RANDOM_SEED=42
